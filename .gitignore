node_modules/
.pnpm-store/
.DS_Store
._*
dist/
coverage/
.turbo/
.codegraph/
.codebase-memory/
playwright-report/
test-results/
backups/
exports/
# Local test/verification artifacts (webwright runs, screenshots) — regenerable, may contain creds
outputs/
docs/testing/
.env
.env.*
!.env.example
# Backup operator env (holds PGPASSWORD etc.) — never commit
infra/backup.env
# Local prod-compose smoke env file (off-git; the *.env* globs miss the .local suffix)
infra/env.production.local

# Claude Code per-machine local settings (never commit)
.claude/settings.local.json

# Superpowers local server/runtime state; content snapshots may be committed intentionally.
.superpowers/**/state/

# Local design-system archive/import
Jarvis Design System.zip
Jarvis Design System/

# #996/#860: resolveModulesDir's dev fallback creates <repoRoot>/data/modules the first
# time a dev runs module-reconcile.ts locally — never commit it.
/data/

# #1326: several unit tests (external-worker-runtime, external-module-invocation-budget,
# module-sdk-worker) mkdtemp() their fixture directly under the repo root rather than
# os.tmpdir(), because the runtime under test resolves paths by walking up for the
# pnpm-workspace.yaml marker and a fixture outside the repo would fail to resolve. Every
# such fixture is prefixed ".tmp-" and removed in afterEach — ignore the prefix so it never
# needs listing per-test-file again.
.tmp-*/
